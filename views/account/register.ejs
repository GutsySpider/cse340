<body id="login">
    <main>
        <h1>
            <%= title %>
        </h1>

        <%- messages() %>
        <% if (errors) { %>
            <ul class="notice">
                <% errors.array().forEach(error=> { %>
                    <li>
                        <%= error.msg %>
                    </li>
                    <% }) %>
            </ul>
            <% } %>
        <form id="register-form" acton="/account/register" method="post">
        
            <label>
                First Name <span class="required">*</span>
                <input type="text" name="account_firstname" required autocomplete="given-name" title="Your First Name">
            </label>
        
            <label>
                Last Name <span class="required">*</span>
                <input type="text" name="account_lastname" required autocomplete="family-name" title="Your Last Name">
            </label>
        
            <label>
                Email <span class="required">*</span>
                <input type="email" name="account_email" required placeholder="john89@gmail.com" title="Your Email"
                    autocomplete="email">
            </label>
        
            <label>
                Password <span class="required">*</span>
                <div class="password-wrapper">
                    <input type="password" name="account_password" id="account_password" required title="Your Password"
                        autocomplete="new-password" pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$">
                    <button type="button" id="togglePassword" class="toggle-btn">Show</button>
                </div>
            </label>
        
            <div class="password-rules">
                <p><strong>Password must:</strong></p>
                <ul>
                    <li>Be at least 12 characters long</li>
                    <li>Contain at least 1 capital letter</li>
                    <li>Contain at least 1 number</li>
                    <li>Contain at least 1 special character</li>
                </ul>
            </div>
        
            <input type="submit" value="Create Your Account">
        
        </form>
    </main>
</body>
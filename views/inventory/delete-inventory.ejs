<h1>
    <%= title %>
</h1>

<%- messages() %>

    <% if (errors && errors.length> 0) { %>
        <div class="notice">
            <ul>
                <% errors.forEach(error=> { %>
                    <li>
                        <%= error.msg %>
                    </li>
                    <% }) %>
            </ul>
        </div>
        <% } %>

            <form id="deleteForm" action="/inv/delete" method="post">
                <label>
                    
                     <span class="required"><p>Confirm Make - The delete is permanent.</p></span>
                    <input readonly type="text" name="inv_make" required value="<%= locals.inv_make || itemData.inv_make %>"
                        placeholder="Min of 3 characters">
                </label>

                <label>
                     <span class="required"><p>Confirm Model - The delete is permanent.</p></span>
                    <input readonly type="text" name="inv_model" required value="<%= locals.inv_model || itemData.inv_model %>"
                        placeholder="Min of 3 characters">
                </label>

                <label>
                     <span class="required"><p>Confirm Year - The delete is permanent.</p></span>
                    <input readonly type="number" name="inv_year" required value="<%= locals.inv_year || itemData.inv_year %>"
                        placeholder="4-digit year">
                </label>


                <label>
                     <span class="required"><p>Confirm Price - The delete is permanent.</p></span>
                    <input readonly type="number" name="inv_price" required value="<%= locals.inv_price || itemData.inv_price %>"
                        placeholder="Decimal or Integer">
                </label>

                <input type="hidden" name="inv_id" value="<%= locals.inv_id || itemData.inv_id %>">

                
                <input type="submit" id="deleteBtn" value="Delete Vehicle">

            </form>
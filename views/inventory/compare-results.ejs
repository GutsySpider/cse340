<% if (title) { %>
    <h1>
        <%= title %>
    </h1>
    <% } else { res.redirect('/') } %>

    <% messages() %>

    <table class="comparison-table">
        <thead>
            <tr>
                <th>Feature</th>
                <th>
                    <%= vehicles[0].inv_make %>
                        <%= vehicles[0].inv_model %>
                </th>
                <th>
                    <%= vehicles[1].inv_make %>
                        <%= vehicles[1].inv_model %>
                </th>
            </tr>
        </thead>
    
    <tbody>
        <tr>
            <td data-label="Feature">Price</td>
            <td data-label="<%= vehicles[0].inv_make %> <%= vehicles[0].inv_model %>">
                $<%= vehicles[0].inv_price %>
            </td>
            <td data-label="<%= vehicles[1].inv_make %> <%= vehicles[1].inv_model %>">
                $<%= vehicles[1].inv_price %>
            </td>
        </tr>
    
        <tr>
            <td data-label="Feature">Mileage</td>
            <td data-label="<%= vehicles[0].inv_make %> <%= vehicles[0].inv_model %>">
                <%= vehicles[0].inv_miles %> miles
            </td>
            <td data-label="<%= vehicles[1].inv_make %> <%= vehicles[1].inv_model %>">
                <%= vehicles[1].inv_miles %> miles
            </td>
        </tr>
    
        <tr>
            <td data-label="Feature">Color</td>
            <td data-label="<%= vehicles[0].inv_make %> <%= vehicles[0].inv_model %>">
                <%= vehicles[0].inv_color %>
            </td>
            <td data-label="<%= vehicles[1].inv_make %> <%= vehicles[1].inv_model %>">
                <%= vehicles[1].inv_color %>
            </td>
        </tr>
    
        <tr>
            <td data-label="Feature">Description</td>
            <td data-label="<%= vehicles[0].inv_make %> <%= vehicles[0].inv_model %>">
                <%= vehicles[0].inv_description %>
            </td>
            <td data-label="<%= vehicles[1].inv_make %> <%= vehicles[1].inv_model %>">
                <%= vehicles[1].inv_description %>
            </td>
        </tr>
    </tbody>
    </table>
<% if (title) { %>
    <h1>
        <%= title %>
    </h1>
    <% } else { res.redirect('/') } %>

    <% messages() %>

    <table class="comparison-table">
        <thead>
            <tr>
                <th>Feature</th>
                <th>
                    <%= vehicles[0].inv_make %>
                        <%= vehicles[0].inv_model %>
                </th>
                <th>
                    <%= vehicles[1].inv_make %>
                        <%= vehicles[1].inv_model %>
                </th>
            </tr>
        </thead>
    
        <tbody>
            <tr>
                <td>Price</td>
                <td>$<%= vehicles[0].inv_price %>
                </td>
                <td>$<%= vehicles[1].inv_price %>
                </td>
            </tr>
            <tr>
                <td>Mileage</td>
                <td>
                    <%= vehicles[0].inv_miles %> miles
                </td>
                <td>
                    <%= vehicles[1].inv_miles %> miles
                </td>
            </tr>
            <tr>
                <td>Color</td>
                <td>
                    <%= vehicles[0].inv_color %>
                </td>
                <td>
                    <%= vehicles[1].inv_color %>
                </td>
            </tr>
            <tr>
                <td>Description</td>
                <td>
                    <%= vehicles[0].inv_description %>
                </td>
                <td>
                    <%= vehicles[1].inv_description %>
                </td>
            </tr>
        </tbody>
    </table>